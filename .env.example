PORT=3000
AI_API_KEY=YOUR_SERVER_SIDE_AI_API_KEY
AI_MODEL=gpt-4o-mini

# iyzico Checkout Form — start with sandbox credentials
IYZICO_API_KEY=sandbox-YOUR_API_KEY
IYZICO_SECRET_KEY=sandbox-YOUR_SECRET_KEY
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Public HTTPS address of this backend; iyzico callback must reach this URL
PUBLIC_BASE_URL=https://your-backend-domain.example
# Keep this database on persistent storage; do not use ephemeral filesystem
SQLITE_PATH=./belge-asistani.sqlite
